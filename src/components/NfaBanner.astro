---
interface Props {
  compact?: boolean;
  onDark?: boolean;
}
const { compact = false, onDark = false } = Astro.props;
---

<aside
  class:list={[
    'nfa-banner',
    compact ? 'nfa-compact' : 'nfa-full',
    onDark ? 'nfa-on-dark' : '',
  ]}
  role="note"
  aria-label="Risk note"
>
  <p>
    <span class="nfa-label">NFA</span>
    <span class="nfa-dot">·</span>
    {
      compact
        ? 'Educational content only. This is not financial advice. Trading involves risk of loss.'
        : 'Everything on Euro Desk FX is for learning and discussion. This is not financial advice. Trading can lead to loss of capital. Only use money you can afford to lose.'
    }
  </p>
</aside>

<style>
  .nfa-banner {
    border: 2px solid #000;
    background: #ffe17c;
    color: #171e19;
    border-radius: 0.75rem;
    box-shadow: 4px 4px 0 #000;
  }

  .nfa-compact {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
  }

  .nfa-full {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
  }

  .nfa-on-dark {
    background: #b7c6c2;
    color: #000;
  }

  .nfa-label {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000;
  }

  .nfa-dot {
    margin: 0 0.5rem;
    opacity: 0.5;
  }
</style>
