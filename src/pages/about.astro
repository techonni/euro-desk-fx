---
import BaseLayout from '../layouts/BaseLayout.astro';
import NfaBanner from '../components/NfaBanner.astro';
import { SITE, withBase } from '../lib/site';
---

<BaseLayout
  title="About"
  description="Euro Desk FX by Techonni. Lifetime VIP ideas on EURUSD and GBPUSD, plus free beginner guides. This is not financial advice."
  canonicalPath="/about/"
>
  <article class="content-col py-14 sm:py-20">
    <p class="label-micro">About</p>
    <h1 class="headline-md mt-3">Euro Desk FX</h1>
    <p class="mt-3 text-sm text-muted-soft">{SITE.byline}</p>
    <div class="mt-8 space-y-4 text-base leading-relaxed text-muted">
      <p>
        <strong class="font-semibold text-fg">{SITE.name}</strong> is an FX education desk.
        The focus stays narrow on purpose: <strong class="font-semibold text-fg">EURUSD</strong> and
        <strong class="font-semibold text-fg">GBPUSD</strong>.
      </p>
      <p>
        <strong class="font-semibold text-fg">{SITE.publisher}</strong> is the studio behind this project.
        The studio home is techonni.com. This site is the education desk.
        On X the same person is {SITE.xHandle}.
      </p>
      <p>
        Beginner guides on this site stay free. Private session ideas are Lifetime VIP for {SITE.vipPrice},
        paid once. The Telegram invite is only shown after checkout. There is no public channel link.
      </p>
      <p>
        Soft risk notes on every page. This is not financial advice. Use the material to study process — then decide for yourself.
      </p>
    </div>
    <p class="mt-8">
      <a href={SITE.checkoutUrl} class="btn-primary">Get Lifetime VIP {SITE.vipPrice} →</a>
    </p>
    <div class="mt-10">
      <NfaBanner />
    </div>
    <p class="mt-10">
      <a href={withBase('/')} class="link-arrow">← Back home</a>
    </p>
  </article>
</BaseLayout>
