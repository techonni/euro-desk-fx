---
import BaseLayout from '../layouts/BaseLayout.astro';
import NfaBanner from '../components/NfaBanner.astro';
import { SITE, withBase } from '../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const steps = [
  {
    title: '1. Entra no Telegram',
    body: 'Canal gratuito, sem VIP e sem upsells. Apenas sinais e contexto educativos.',
  },
  {
    title: '2. Foco em dois pares',
    body: 'EURUSD e GBPUSD — liquidez alta, spreads tipicamente mais estáveis, sessões claras.',
  },
  {
    title: '3. Lê o contexto',
    body: 'Cada ideia vem com estrutura e aviso NFA. Não é ordem — é material para estudo.',
  },
  {
    title: '4. Gerir o risco',
    body: 'Educação sobre tamanho de posição e disciplina. Sem promessas de lucro.',
  },
];
---

<BaseLayout title={SITE.name} description={SITE.description} canonicalPath="/">
  <section class="relative overflow-hidden bg-navy text-cream">
    <div
      class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-mint/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 left-10 h-64 w-64 rounded-full bg-coral/25 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
      <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-mint/40 bg-white/5 px-3 py-1 text-xs font-medium text-mint">
        Faceless · Free Telegram · Sem VIP
      </p>
      <h1 class="max-w-2xl text-3xl font-bold tracking-tight sm:text-5xl">
        Sinais FX sem rosto para <span class="text-coral">EURUSD</span> e
        <span class="text-mint">GBPUSD</span>
      </h1>
      <p class="mt-5 max-w-xl text-base text-cream/80 sm:text-lg">
        {SITE.name} partilha ideias e educação de forex de forma anónima. Zero fotos de cara. Zero
        pricing VIP. Canal Telegram gratuito.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={SITE.telegram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-coral px-6 py-3 font-semibold text-navy shadow-lg shadow-coral/20 transition hover:bg-coral-soft"
        >
          Entrar no Telegram gratuito
        </a>
        <a
          href={withBase('/blog/')}
          class="inline-flex items-center justify-center rounded-full border border-cream/30 px-6 py-3 font-medium text-cream transition hover:border-mint hover:text-mint"
        >
          Ler o blog educativo
        </a>
      </div>
      <div class="mt-8 max-w-2xl">
        <NfaBanner />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6" aria-labelledby="pairs-heading">
    <h2 id="pairs-heading" class="text-2xl font-bold text-navy">Pares em foco</h2>
    <p class="mt-2 max-w-2xl text-navy/70">
      Mantemos o universo pequeno de propósito: profundidade em vez de ruído.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        SITE.pairs.map((pair, i) => (
          <article class="rounded-2xl border border-navy/10 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
              <h3 class="text-xl font-semibold text-navy">{pair}</h3>
              <span
                class:list={[
                  'rounded-full px-3 py-1 text-xs font-semibold',
                  i === 0 ? 'bg-mint/30 text-navy' : 'bg-coral/30 text-navy',
                ]}
              >
                Core
              </span>
            </div>
            <p class="mt-3 text-sm text-navy/70">
              {pair === 'EURUSD'
                ? 'O par mais líquido do mundo. Ideal para estudar sessões de Londres e Nova Iorque, e o impacto de dados da zona euro e dos EUA.'
                : 'Sensível a dados do Reino Unido e ao risco global. Bom laboratório para volatilidade e gestão de stop.'}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-white/60 py-14" aria-labelledby="how-heading">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 id="how-heading" class="text-2xl font-bold text-navy">Como funciona</h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          steps.map((step) => (
            <li class="rounded-2xl border border-navy/10 bg-cream p-5">
              <h3 class="font-semibold text-navy">{step.title}</h3>
              <p class="mt-2 text-sm text-navy/70">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6" aria-labelledby="blog-heading">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 id="blog-heading" class="text-2xl font-bold text-navy">Do blog (PT)</h2>
        <p class="mt-2 text-navy/70">Artigos educativos — sempre com NFA.</p>
      </div>
      <a href={withBase('/blog/')} class="text-sm font-medium text-navy-light underline decoration-coral underline-offset-2"
        >Ver todos</a
      >
    </div>
    <ul class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        posts.map((post) => (
          <li>
            <a
              href={withBase(`/blog/${post.id}/`)}
              class="block h-full rounded-2xl border border-navy/10 bg-white p-5 shadow-sm transition hover:border-mint hover:shadow-md"
            >
              <time class="text-xs text-navy/50" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('pt-PT', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-2 font-semibold text-navy">{post.data.title}</h3>
              <p class="mt-2 text-sm text-navy/65">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6">
    <div class="rounded-3xl bg-navy px-6 py-10 text-center text-cream sm:px-10">
      <h2 class="text-2xl font-bold">Pronto para seguir sem hype?</h2>
      <p class="mx-auto mt-3 max-w-lg text-cream/75">
        Junta-te ao canal gratuito. Sem cara, sem VIP, sem milagres — só disciplina e pares claros.
      </p>
      <a
        href={SITE.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex rounded-full bg-mint px-6 py-3 font-semibold text-navy transition hover:bg-mint-soft"
      >
        Abrir Telegram · @EuroDeskFX
      </a>
      <div class="mx-auto mt-6 max-w-xl text-left">
        <NfaBanner compact />
      </div>
    </div>
  </section>
</BaseLayout>
