---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NfaBanner from '../../components/NfaBanner.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Beginner FX guides in plain English — EURUSD, GBPUSD, London session, and risk. Euro Desk FX. This is not financial advice."
  canonicalPath="/blog/"
>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="label-micro">Blog</p>
    <h1 class="headline-md mt-3" style="font-size: clamp(2rem, 5vw, 3.25rem);">Guides for beginners</h1>
    <p class="mt-4 max-w-xl text-base text-muted">
      Plain English articles on pairs, sessions, and risk. No hype. No VIP wall.
    </p>
    <div class="mt-8">
      <NfaBanner compact />
    </div>

    <ul class="mt-12 space-y-0">
      {
        posts.map((post) => (
          <li class="border-t border-border">
            <a
              href={withBase(`/blog/${post.id}/`)}
              class="group block py-6 no-underline transition"
            >
              <div class="flex flex-wrap items-center gap-2">
                <time class="label-micro" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-GB', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-full bg-glass px-2.5 py-0.5 text-xs font-semibold text-muted-soft">{tag}</span>
                ))}
              </div>
              <h2 class="mt-3 text-xl font-semibold text-fg group-hover:text-forest">{post.data.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
              <p class="link-arrow mt-3">Read →</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
