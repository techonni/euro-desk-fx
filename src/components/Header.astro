---
import { SITE, withBase } from '../lib/site';

const nav = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/blog/'), label: 'Blog' },
  { href: withBase('/about/'), label: 'About' },
  { href: withBase('/disclaimer/'), label: 'Disclaimer' },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/95 backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-3 px-4 sm:h-16 sm:px-6">
    <a href={withBase('/')} class="group flex min-w-0 items-center gap-2.5 no-underline sm:gap-3">
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center border border-border bg-bg text-[11px] font-bold tracking-tight text-fg sm:h-10 sm:w-10"
        aria-hidden="true"
      >FX</span>
      <span class="label-micro truncate text-fg group-hover:text-cream">{SITE.name}</span>
    </a>

    <div class="flex shrink-0 items-center gap-2.5 sm:gap-3">
      <a
        href={SITE.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-10 items-center justify-center border border-[#2a2a2a] bg-black px-3.5 text-[0.625rem] font-bold uppercase tracking-[0.12em] text-white no-underline transition hover:border-[#3a3a3a] hover:bg-[#141414] sm:h-11 sm:px-4 sm:text-[0.6875rem]"
      >
        Telegram
      </a>

      <button
        type="button"
        id="nav-menu-btn"
        class="inline-flex h-11 w-11 items-center justify-center border border-border text-fg transition hover:border-[#333] sm:h-12 sm:w-12"
        aria-label="Open menu"
        aria-controls="nav-drawer"
        aria-expanded="false"
      >
        <svg class="h-6 w-6 sm:h-7 sm:w-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="nav-backdrop" class="nav-backdrop" hidden></div>

<aside
  id="nav-drawer"
  class="nav-drawer"
  aria-label="Site menu"
  aria-hidden="true"
>
  <div class="nav-drawer-top">
    <p class="label-micro text-fg">Menu</p>
    <button
      type="button"
      id="nav-menu-close"
      class="nav-icon-btn"
      aria-label="Close menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
      </svg>
    </button>
  </div>
  <nav class="nav-drawer-links" aria-label="Pages">
    {
      nav.map((item) => (
        <a href={item.href} class="nav-drawer-link label-micro">
          {item.label}
        </a>
      ))
    }
  </nav>
</aside>

<script is:inline>
  (function () {
    function setupNav() {
      const btn = document.getElementById('nav-menu-btn');
      const closeBtn = document.getElementById('nav-menu-close');
      const drawer = document.getElementById('nav-drawer');
      const backdrop = document.getElementById('nav-backdrop');
      if (!btn || !closeBtn || !drawer || !backdrop) return;
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';

      function open() {
        backdrop.hidden = false;
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.classList.add('nav-lock');
      }

      function close() {
        drawer.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('nav-lock');
        window.setTimeout(function () {
          if (!backdrop.classList.contains('is-open')) backdrop.hidden = true;
        }, 320);
      }

      btn.addEventListener('click', function () {
        if (btn.getAttribute('aria-expanded') === 'true') close();
        else open();
      });
      closeBtn.addEventListener('click', close);
      backdrop.addEventListener('click', close);
      drawer.querySelectorAll('.nav-drawer-link').forEach(function (link) {
        link.addEventListener('click', close);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') close();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupNav);
    } else {
      setupNav();
    }
    document.addEventListener('astro:page-load', setupNav);
  })();
</script>

<style is:global>
  body.nav-lock {
    overflow: hidden;
  }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .nav-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    display: flex;
    flex-direction: column;
    width: min(50vw, 20rem);
    max-width: 50%;
    background: #0a0a0a;
    border-left: 1px solid #1f1f1f;
    transform: translateX(100%);
    transition: transform 0.3s ease-out;
  }

  .nav-drawer.is-open {
    transform: translateX(0);
  }

  .nav-drawer-top {
    display: flex;
    height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #1f1f1f;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .nav-drawer-top {
      height: 4rem;
      padding: 0 1.25rem;
    }
  }

  .nav-icon-btn {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #1f1f1f;
    color: #f5f5f5;
    background: transparent;
    cursor: pointer;
  }

  .nav-drawer-links {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
  }

  .nav-drawer-link {
    display: block;
    padding: 0.9rem 0.75rem;
    color: #a3a3a3;
    text-decoration: none;
    border: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav-drawer-link:hover {
    color: #f5f5f5;
    border-color: #1f1f1f;
  }
</style>
