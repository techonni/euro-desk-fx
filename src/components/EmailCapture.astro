---
import { SITE, withBase } from '../lib/site';

const action = SITE.newsletterFormAction;
const ready = Boolean(action);
---

<section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6" aria-labelledby="email-capture-heading">
  <div>
    <h2 id="email-capture-heading" class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
      Get tips in your inbox
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
      Leave your email and you can receive beginner FX tips from
      <span class="text-fg">{SITE.name}</span>
      ({SITE.byline}). No spam. Stop any time. This is not financial advice.
    </p>

    {
      ready ? (
        <form id="nl-form" class="nl-form mt-6" action={action} method="POST" novalidate>
          <input type="hidden" name={SITE.newsletterSourceEntry} value="techonni.com · Euro Desk FX" />
          <input
            type="hidden"
            name={SITE.newsletterConsentEntry}
            value="Yes — I agree to receive emails from Euro Desk FX by Techonni"
          />
          <input type="hidden" name={SITE.newsletterNameEntry} value="—" />
          <div class="nl-row">
            <label class="sr-only" for="nl-email">Your email</label>
            <input
              id="nl-email"
              class="nl-email"
              name={SITE.newsletterEmailEntry}
              type="email"
              required
              autocomplete="email"
              placeholder="Enter your email address"
            />
            <button id="nl-submit" class="nl-submit" type="submit">
              Send me tips
            </button>
          </div>
          <p class="mt-3 text-xs text-muted-soft">
            By sending, you ask for tips by email.
            <a class="underline decoration-border underline-offset-2 hover:text-fg" href={withBase('/privacy/')}>Privacy</a>.
          </p>
        </form>
      ) : (
        <div class="mt-6 border border-border bg-bg p-4 text-sm text-muted">
          <p class="text-fg">Email signup connects next.</p>
          <p class="mt-2">
            Until then, join the free channel:
            <a class="link-arrow ml-1" href={SITE.telegram} target="_blank" rel="noopener noreferrer">
              Telegram →
            </a>
          </p>
        </div>
      )
    }
  </div>
</section>

{
  ready && (
    <script is:inline>
      (function () {
        function setupNewsletter() {
          var form = document.getElementById('nl-form');
          var email = document.getElementById('nl-email');
          var btn = document.getElementById('nl-submit');
          if (!form || !email || !btn) return;
          if (form.dataset.bound === '1') return;
          form.dataset.bound = '1';

          form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!email.checkValidity()) {
              email.reportValidity();
              return;
            }

            var body = new FormData(form);
            btn.classList.add('is-flash');
            btn.disabled = true;

            fetch(form.action, {
              method: 'POST',
              mode: 'no-cors',
              body: body,
            }).catch(function () {});

            email.value = '';

            window.setTimeout(function () {
              btn.classList.remove('is-flash');
              btn.disabled = false;
            }, 1000);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setupNewsletter);
        } else {
          setupNewsletter();
        }
        document.addEventListener('astro:page-load', setupNewsletter);
      })();
    </script>
  )
}

<style is:global>
  .nl-form {
    width: 100%;
    max-width: 28rem;
  }

  .nl-row {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nl-email,
  .nl-submit {
    box-sizing: border-box;
    height: 3.5rem;
    min-height: 3.5rem;
    max-height: 3.5rem;
    width: 100%;
    margin: 0;
    border: 1px solid #1f1f1f;
    font-size: 16px;
    line-height: 1.25;
  }

  .nl-email {
    -webkit-appearance: none;
    appearance: none;
    background: #141414;
    color: #f5f5f5;
    padding: 0 1rem;
    outline: none;
  }

  .nl-email::placeholder {
    color: #737373;
  }

  .nl-email:focus {
    border-color: #333;
  }

  .nl-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    color: #0a0a0a;
    border-color: #f5f5f5;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .nl-submit:hover {
    background: #e8e4d9;
  }

  .nl-submit.is-flash {
    background: #0a0a0a !important;
    color: #f5f5f5 !important;
    border-color: #2a2a2a !important;
  }

  /* Laptop / MacBook / desktop — side by side (tablets portrait stay stacked) */
  @media (min-width: 1024px) {
    .nl-form {
      max-width: 36rem;
    }

    .nl-row {
      flex-direction: row;
      align-items: stretch;
      flex-wrap: nowrap;
    }

    .nl-email {
      flex: 1 1 auto;
      min-width: 0;
      width: auto;
    }

    .nl-submit {
      flex: 0 0 auto;
      width: auto;
      min-width: 11rem;
      padding: 0 1.5rem;
      white-space: nowrap;
    }
  }
</style>
