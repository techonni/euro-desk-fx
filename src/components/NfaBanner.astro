---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<aside
  class:list={[
    'border border-border bg-bg-elevated text-muted',
    compact ? 'px-3 py-2 text-xs' : 'px-4 py-3 text-sm',
  ]}
  role="note"
  aria-label="Risk note"
>
  <p>
    <span class="label-micro text-cream">NFA</span>
    <span class="mx-2 text-border">·</span>
    {
      compact
        ? 'Educational content only. This is not financial advice. Trading involves risk of loss.'
        : 'Everything on Euro Desk FX is for learning and discussion. This is not financial advice. Trading can lead to loss of capital. Only use money you can afford to lose.'
    }
  </p>
</aside>
