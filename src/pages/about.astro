---
import BaseLayout from '../layouts/BaseLayout.astro';
import NfaBanner from '../components/NfaBanner.astro';
import { SITE, withBase } from '../lib/site';
---

<BaseLayout
  title="About"
  description="Euro Desk FX is a free FX education desk focused on EURUSD and GBPUSD. Plain English. Soft risk notes. This is not financial advice."
  canonicalPath="/about/"
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="label-micro">About</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-fg sm:text-5xl">Euro Desk FX</h1>
    <div class="mt-8 space-y-4 text-base leading-relaxed text-muted">
      <p>
        <strong class="text-fg">{SITE.name}</strong> is a free desk for FX education and market ideas.
        The focus stays narrow on purpose: <strong class="text-fg">EURUSD</strong> and
        <strong class="text-fg">GBPUSD</strong>.
      </p>
      <p>
        You get simple English, session context, and soft risk reminders. There is no VIP pricing and no
        promise of profit. The main channel is free Telegram —
        <a class="text-fg underline decoration-border underline-offset-4 hover:decoration-cyan" href={SITE.telegram} target="_blank" rel="noopener noreferrer"
          >t.me/EuroDeskFX</a
        >
        — with short updates on
        <a class="text-fg underline decoration-border underline-offset-4 hover:decoration-cyan" href={SITE.x} target="_blank" rel="noopener noreferrer"
          >X {SITE.xHandle}</a
        >.
      </p>
      <p>
        This site explains the project, hosts beginner articles, and keeps the disclaimer easy to find.
        This is not financial advice. Use the material to study process — then decide for yourself.
      </p>
    </div>
    <div class="mt-10">
      <NfaBanner />
    </div>
    <p class="mt-10">
      <a href={withBase('/')} class="link-arrow">← Back home</a>
    </p>
  </article>
</BaseLayout>
