---
import { SITE, withBase } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="mt-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <hr class="border-border" />
    <div class="flex flex-col gap-6 py-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <p class="label-micro text-fg">{SITE.name}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Free FX education and market ideas. Focus on {SITE.pairs.join(' and ')}. Soft risk note on every page.
        </p>
      </div>
      <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <a class="link-arrow" href={withBase('/blog/')}>Blog →</a>
        <a class="link-arrow" href={withBase('/about/')}>About →</a>
        <a class="link-arrow" href={withBase('/privacy/')}>Privacy →</a>
        <a class="link-arrow" href={withBase('/disclaimer/')}>Disclaimer →</a>
        <a class="link-arrow" href={SITE.telegram} target="_blank" rel="noopener noreferrer">Telegram →</a>
        <a class="link-arrow" href={SITE.x} target="_blank" rel="noopener noreferrer">X {SITE.xHandle} →</a>
      </div>
    </div>
    <div class="border-t border-border-soft pb-8 pt-6 text-xs text-muted-soft">
      <p>
        © {year} {SITE.name}. This is not financial advice. Trading involves risk of loss.
      </p>
    </div>
  </div>
</footer>
