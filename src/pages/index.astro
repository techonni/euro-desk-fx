---
import BaseLayout from '../layouts/BaseLayout.astro';
import NfaBanner from '../components/NfaBanner.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { SITE, withBase } from '../lib/site';
import { HERO_PHONE_SRC } from '../lib/heroPhone';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const paths = [
  {
    title: 'Lifetime VIP',
    body: 'Private EURUSD and GBPUSD ideas. One payment of €77. The invite is only shown after checkout.',
    href: withBase('/vip/'),
    external: false,
    cta: 'Get VIP',
  },
  {
    title: 'Blog',
    body: 'Short beginner guides in plain English. Read at your pace. No hype.',
    href: withBase('/blog/'),
    external: false,
    cta: 'Read the blog',
  },
  {
    title: 'Two pairs',
    body: 'EURUSD and GBPUSD only. Less noise. Clear sessions. Room to study structure and risk.',
    href: withBase('/about/'),
    external: false,
    cta: 'How it works',
  },
];

const steps = [
  {
    n: '01',
    title: 'Pay once',
    body: 'Lifetime VIP is €77. Stripe checkout. You get a receipt.',
  },
  {
    n: '02',
    title: 'Open the private channel',
    body: 'The Telegram invite appears on the VIP page after payment. It is not listed in search.',
  },
  {
    n: '03',
    title: 'Read the guides',
    body: 'The blog stays free. Ideas in the channel are for study — not orders to copy.',
  },
];
---

<BaseLayout title={SITE.name} description={SITE.description} canonicalPath="/">
  <section class="hero">
    <div class="content-col hero-row">
      <div class="hero-copy">
        <p class="label-micro">FX education desk · NFA</p>
        <h1 class="display-lg mt-4">Learn FX with a clear desk</h1>
        <p class="hero-bio">
          Lifetime VIP ideas on <strong>EURUSD</strong> and <strong>GBPUSD</strong>, plus free beginner guides.
          Simple English. This is not financial advice.
        </p>
        <div class="hero-actions">
          <a href={withBase('/vip/')} class="btn-primary">Get Lifetime VIP →</a>
          <a href={withBase('/blog/')} class="link-arrow hero-secondary">Read blog →</a>
        </div>
        <p class="hero-byline">{SITE.byline}</p>
      </div>
      <img class="hero-phone" src={HERO_PHONE_SRC} width="240" height="483" alt="Free M15 Euro Desk FX on iPhone" />
    </div>
  </section>

  <section class="paths" aria-labelledby="paths-heading">
    <div class="content-col">
      <p class="label-micro">On the desk</p>
      <h2 id="paths-heading" class="headline-md mt-2">Three ways to start</h2>
      <ul class="path-list">
        {paths.map((item) => (
          <li>
            <a href={item.href} class="path-link">
              <div class="path-text">
                <p class="path-title">{item.title}</p>
                <p class="path-body">{item.body}</p>
              </div>
              <span class="path-cta">{item.cta} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="how" aria-labelledby="how-heading">
    <div class="content-col">
      <p class="label-micro">Process</p>
      <h2 id="how-heading" class="headline-md mt-2">How it works</h2>
      <ol class="step-list">
        {steps.map((step) => (
          <li class="step-item">
            <span class="step-n" aria-hidden="true">{step.n}</span>
            <div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-body">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="blog-latest" aria-labelledby="blog-heading">
    <div class="content-col">
      <div class="blog-head">
        <div>
          <p class="label-micro">From the blog</p>
          <h2 id="blog-heading" class="headline-md mt-2">Beginner guides</h2>
        </div>
        <a href={withBase('/blog/')} class="link-arrow">All posts →</a>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a href={withBase(`/blog/${post.id}/`)} class="post-link">
              <time class="label-micro" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <h3 class="post-title">{post.data.title}</h3>
              <p class="post-desc">{post.data.description}</p>
              <span class="link-arrow post-more">Read →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="newsletter-band">
    <div class="content-col">
      <EmailCapture variant="widget" heading="Tips by email" />
    </div>
  </section>

  <section class="final-cta">
    <div class="content-col">
      <p class="label-micro">Next step</p>
      <h2 class="headline-md mt-2">Get Lifetime VIP for {SITE.vipPrice}</h2>
      <p class="cta-copy">
        Private ideas on EURUSD and GBPUSD. The channel is not public. Pay once. Keep risk small. Not financial advice.
      </p>
      <div class="cta-actions">
        <a href={withBase('/vip/')} class="btn-primary">Open VIP →</a>
        <a href={SITE.x} target="_blank" rel="noopener noreferrer" class="link-arrow">Follow on X {SITE.xHandle} →</a>
      </div>
      <div class="mt-8"><NfaBanner compact /></div>
    </div>
  </section>
</BaseLayout>
