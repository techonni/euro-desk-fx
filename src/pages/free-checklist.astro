---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import { SITE, withBase } from '../lib/site';
import { HERO_PHONE_SRC } from '../lib/heroPhone';

const action = SITE.newsletterFormAction;
const thankYou = withBase('/checklist-ready/');

const benefits = [
  'The exact pre-trade checks I run before every EURUSD & GBPUSD trade',
  'Where to place your stop-loss so one loss never hurts you',
  'A simple risk rule that keeps small accounts alive',
  'The two sessions when these pairs actually move',
];
---

<FunnelLayout
  title="Free EURUSD & GBPUSD Beginner Checklist"
  description="Get the free 1-page checklist for trading EURUSD and GBPUSD: pre-trade checks, stop-loss placement and a simple risk rule. Not financial advice."
  canonicalPath="/free-checklist/"
>
  <section class="funnel-wrap">
    <span class="funnel-eyebrow">Free PDF · EURUSD &amp; GBPUSD</span>
    <h1 class="funnel-h1">
      Stop guessing your trades. <span class="hl">Follow a checklist.</span>
    </h1>
    <p class="funnel-sub">
      Get the free 1-page checklist I run before every EURUSD &amp; GBPUSD trade — the exact
      pre-trade checks, stop-loss rule and risk rule that keep beginners out of trouble.
    </p>

    <img class="squeeze-visual" src={HERO_PHONE_SRC} width="200" height="403" alt="Euro Desk FX checklist on a phone" loading="eager" fetchpriority="high" />

    <ul class="funnel-benefits">
      {benefits.map((b) => (
        <li class="funnel-benefit"><span class="bchk" aria-hidden="true">✓</span><span>{b}</span></li>
      ))}
    </ul>

    <form id="lm-form" class="squeeze-form" action={action} method="POST" novalidate>
      <input type="hidden" name={SITE.newsletterSourceEntry} value="fx.techonni.com · Free Checklist" />
      <input type="hidden" name={SITE.newsletterConsentEntry} value="Yes — I agree to receive emails from Euro Desk FX by Techonni" />
      <input type="hidden" name={SITE.newsletterNameEntry} value="—" />
      <label class="sr-only" for="lm-email">Your email</label>
      <input id="lm-email" class="squeeze-email" name={SITE.newsletterEmailEntry} type="email" required autocomplete="email" placeholder="Enter your best email" />
      <button id="lm-submit" class="funnel-cta" type="submit">Send me the free checklist →</button>
    </form>

    <div class="funnel-trust">
      <span>✓ 100% free</span>
      <span>✓ No spam</span>
      <span>✓ Unsubscribe anytime</span>
    </div>

    <p class="squeeze-legal">
      Educational only. This is not financial advice. Trading involves risk of loss.
    </p>
  </section>
</FunnelLayout>

<script is:inline define:vars={{ thankYou }}>
  (function () {
    function setup() {
      var form = document.getElementById('lm-form');
      var email = document.getElementById('lm-email');
      var btn = document.getElementById('lm-submit');
      if (!form || !email || !btn || form.dataset.bound === '1') return;
      form.dataset.bound = '1';
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!email.checkValidity()) { email.reportValidity(); return; }
        btn.disabled = true;
        btn.textContent = 'Sending…';
        try {
          fetch(form.action, { method: 'POST', mode: 'no-cors', body: new FormData(form) }).catch(function () {});
        } catch (err) {}
        try { localStorage.setItem('fx_optin', String(Date.now())); } catch (e) {}
        window.setTimeout(function () { window.location.href = thankYou; }, 600);
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
    else setup();
  })();
</script>

<style>
  .squeeze-visual { display: block; margin: 1.75rem auto 0; height: auto; }
  .squeeze-form { margin: 1.75rem auto 0; max-width: 30rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .squeeze-email { box-sizing: border-box; height: 3.25rem; width: 100%; border-radius: 0.75rem; border: 1.5px solid #d8d8d8; background: #fff; color: #111; padding: 0 1.1rem; font-size: 1rem; outline: none; text-align: center; }
  .squeeze-email:focus { border-color: #16a34a; box-shadow: 0 0 0 3px rgba(22,163,74,0.15); }
  .squeeze-email::placeholder { color: #999; }
  .squeeze-legal { margin: 1.5rem auto 0; max-width: 28rem; font-size: 0.75rem; color: #aaa; line-height: 1.5; }
</style>
