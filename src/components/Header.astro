---
import { SITE, withBase } from '../lib/site';

const nav = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/blog/'), label: 'Blog' },
  { href: withBase('/about/'), label: 'About' },
  { href: withBase('/disclaimer/'), label: 'Disclaimer' },
];
---

<header class="site-header fixed top-0 z-40 w-full">
  <div class="mx-auto flex h-20 max-w-[1440px] items-center justify-between gap-3 px-4 sm:px-6 lg:px-10">
    <a href={withBase('/')} class="group flex min-w-0 items-center gap-2.5 no-underline sm:gap-3">
      <span
        class="fx-mark flex h-10 w-10 shrink-0 items-center justify-center text-sm font-extrabold tracking-tight"
        aria-hidden="true"
      >FX</span>
      <span class="truncate font-display text-base font-extrabold text-black sm:text-lg">{SITE.name}</span>
    </a>

    <div class="flex shrink-0 items-center gap-2.5 sm:gap-3">
      <a
        href={SITE.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-nav-cta"
      >
        Join Telegram
      </a>

      <button
        type="button"
        id="nav-menu-btn"
        class="nav-toggle"
        aria-label="Open menu"
        aria-controls="nav-drawer"
        aria-expanded="false"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="nav-backdrop" class="nav-backdrop" hidden></div>

<aside
  id="nav-drawer"
  class="nav-drawer"
  aria-label="Site menu"
  aria-hidden="true"
>
  <div class="nav-drawer-top">
    <button
      type="button"
      id="nav-menu-close"
      class="nav-icon-btn ml-auto"
      aria-label="Close menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <nav class="nav-drawer-links" aria-label="Pages">
    {
      nav.map((item) => (
        <a href={item.href} class="nav-drawer-link">
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="nav-drawer-foot">
    <a
      href={SITE.telegram}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary w-full"
      style="height: 3rem;"
    >
      Join free Telegram
    </a>
  </div>
</aside>

<!-- spacer for fixed header -->
<div class="h-20" aria-hidden="true"></div>

<script is:inline>
  (function () {
    function setupNav() {
      const btn = document.getElementById('nav-menu-btn');
      const closeBtn = document.getElementById('nav-menu-close');
      const drawer = document.getElementById('nav-drawer');
      const backdrop = document.getElementById('nav-backdrop');
      if (!btn || !closeBtn || !drawer || !backdrop) return;
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';

      function open() {
        backdrop.hidden = false;
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.classList.add('nav-lock');
      }

      function close() {
        drawer.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('nav-lock');
        window.setTimeout(function () {
          if (!backdrop.classList.contains('is-open')) backdrop.hidden = true;
        }, 320);
      }

      btn.addEventListener('click', function () {
        if (btn.getAttribute('aria-expanded') === 'true') close();
        else open();
      });
      closeBtn.addEventListener('click', close);
      backdrop.addEventListener('click', close);
      drawer.querySelectorAll('.nav-drawer-link').forEach(function (link) {
        link.addEventListener('click', close);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') close();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupNav);
    } else {
      setupNav();
    }
    document.addEventListener('astro:page-load', setupNav);
  })();
</script>

<style is:global>
  body.nav-lock {
    overflow: hidden;
  }

  .site-header {
    background: #ffe17c;
    border-bottom: 2px solid #000;
  }

  .fx-mark {
    background: #000;
    color: #ffe17c;
    border: 2px solid #000;
    border-radius: 0.5rem;
  }

  .nav-toggle {
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    border: 2px solid #000;
    background: #fff;
    color: #000;
    box-shadow: 4px 4px 0 #000;
    cursor: pointer;
    transition:
      transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      box-shadow 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .nav-toggle:hover {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 #000;
  }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(23, 30, 25, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .nav-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 70;
    display: flex;
    flex-direction: column;
    width: min(50vw, 20rem);
    max-width: 50%;
    background: #fff;
    border-left: 2px solid #000;
    box-shadow: -8px 0 0 #000;
    transform: translateX(100%);
    transition: transform 0.3s ease-out;
  }

  .nav-drawer.is-open {
    transform: translateX(0);
  }

  .nav-drawer-top {
    display: flex;
    height: 5rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid #000;
    padding: 0 1rem;
    background: #ffe17c;
  }

  .nav-icon-btn {
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    border: 2px solid #000;
    color: #000;
    background: #fff;
    box-shadow: 4px 4px 0 #000;
    cursor: pointer;
    transition:
      transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      box-shadow 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .nav-icon-btn:hover {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 #000;
  }

  .nav-drawer-links {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
  }

  .nav-drawer-link {
    display: block;
    padding: 0.9rem 1rem;
    color: #000;
    font-size: 1.125rem;
    font-weight: 800;
    font-family: "Cabinet Grotesk", "Space Grotesk", sans-serif;
    text-decoration: none;
    border: 2px solid transparent;
    border-radius: 0.75rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-drawer-link:hover {
    background: #ffe17c;
    border-color: #000;
  }

  .nav-drawer-foot {
    padding: 1rem 1.25rem 1.5rem;
    border-top: 2px solid #000;
  }
</style>
