---
import BaseLayout from '../layouts/BaseLayout.astro';
import NfaBanner from '../components/NfaBanner.astro';
import { SITE, withBase } from '../lib/site';
---

<BaseLayout
  title="About"
  description="Euro Desk FX by Techonni is a free FX education desk focused on EURUSD and GBPUSD. Plain English. Soft risk notes. This is not financial advice."
  canonicalPath="/about/"
>
  <article class="content-col py-14 sm:py-20">
    <p class="label-micro">About</p>
    <h1 class="headline-md mt-3">Euro Desk FX</h1>
    <p class="mt-3 text-sm text-muted-soft">{SITE.byline}</p>
    <div class="mt-8 space-y-4 text-base leading-relaxed text-muted">
      <p>
        <strong class="font-semibold text-fg">{SITE.name}</strong> is a free desk for FX education and market ideas.
        The focus stays narrow on purpose: <strong class="font-semibold text-fg">EURUSD</strong> and
        <strong class="font-semibold text-fg">GBPUSD</strong>.
      </p>
      <p>
        <strong class="font-semibold text-fg">{SITE.publisher}</strong> is the studio behind this project.
        You visit the site at techonni.com — that is the home of the studio. The product you follow
        on Telegram and X is still <strong class="font-semibold text-fg">Euro Desk FX</strong>
        ({SITE.xHandle} / t.me/EuroDeskFX). One brand for the desk. One publisher behind it.
      </p>
      <p>
        You get simple English, session context, and soft risk reminders. There is no VIP pricing and no
        promise of profit. The main channel is free Telegram —
        <a class="font-medium text-fg underline underline-offset-4" href={SITE.telegram} target="_blank" rel="noopener noreferrer"
          >t.me/EuroDeskFX</a
        >
        — with short updates on
        <a class="font-medium text-fg underline underline-offset-4" href={SITE.x} target="_blank" rel="noopener noreferrer"
          >X {SITE.xHandle}</a
        >.
      </p>
      <p>
        This site explains the project, hosts beginner articles, and keeps the disclaimer easy to find.
        This is not financial advice. Use the material to study process — then decide for yourself.
      </p>
    </div>
    <div class="mt-10">
      <NfaBanner />
    </div>
    <p class="mt-10">
      <a href={withBase('/')} class="link-arrow">← Back home</a>
    </p>
  </article>
</BaseLayout>
