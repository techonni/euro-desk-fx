---
import { SITE, withBase } from '../lib/site';

const action = SITE.newsletterFormAction;
const ready = Boolean(action);
---

<section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6" aria-labelledby="email-capture-heading">
  <div class="grid gap-0 overflow-hidden border border-border bg-bg-elevated sm:grid-cols-2">
    <div class="relative min-h-[200px] border-b border-border sm:min-h-full sm:border-b-0 sm:border-r">
      <img
        src={withBase('hero-chart.jpg')}
        alt=""
        width="640"
        height="480"
        class="absolute inset-0 h-full w-full object-cover opacity-90"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/40 to-transparent sm:bg-gradient-to-r"></div>
      <div class="relative flex h-full min-h-[200px] flex-col justify-end p-6 sm:p-8">
        <p class="label-micro text-cream">Tips & tricks</p>
        <p class="mt-2 max-w-xs text-lg font-semibold tracking-tight text-fg">
          EURUSD & GBPUSD notes in plain English.
        </p>
      </div>
    </div>

    <div class="flex flex-col justify-center p-6 sm:p-8">
      <h2 id="email-capture-heading" class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
        Get tips in your inbox
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        Share your name and email here and you can receive beginner FX tips from
        <span class="text-fg">{SITE.name}</span>
        ({SITE.byline}). No spam. Unsubscribe any time. This is not financial advice.
      </p>

      {
        ready ? (
          <form class="mt-6 space-y-4" action={action} method="POST" target="_blank">
            <input type="hidden" name={SITE.newsletterSourceEntry} value="techonni.com · Euro Desk FX" />
            <div>
              <label for="nl-name" class="label-micro text-muted-soft">
                Your name
              </label>
              <input
                id="nl-name"
                name={SITE.newsletterNameEntry}
                type="text"
                required
                autocomplete="name"
                class="mt-2 w-full border border-border bg-bg px-3 py-2.5 text-sm text-fg outline-none placeholder:text-muted-soft focus:border-[#333]"
                placeholder="Alex"
              />
            </div>
            <div>
              <label for="nl-email" class="label-micro text-muted-soft">
                Your email
              </label>
              <input
                id="nl-email"
                name={SITE.newsletterEmailEntry}
                type="email"
                required
                autocomplete="email"
                class="mt-2 w-full border border-border bg-bg px-3 py-2.5 text-sm text-fg outline-none placeholder:text-muted-soft focus:border-[#333]"
                placeholder="you@email.com"
              />
            </div>
            <label class="flex items-start gap-3 text-xs leading-relaxed text-muted">
              <input
                type="checkbox"
                name={SITE.newsletterConsentEntry}
                value="Yes — I agree to receive emails from Euro Desk FX by Techonni"
                required
                class="mt-0.5"
              />
              <span>
                You agree to get occasional tips by email about Euro Desk FX / Techonni. You can stop any time.
              </span>
            </label>
            <button type="submit" class="badge-rect-solid">
              Send me tips
            </button>
          </form>
        ) : (
          <div class="mt-6 border border-border bg-bg p-4 text-sm text-muted">
            <p class="text-fg">Email signup connects next.</p>
            <p class="mt-2">
              Until then, join the free channel:
              <a class="link-arrow ml-1" href={SITE.telegram} target="_blank" rel="noopener noreferrer">
                Telegram →
              </a>
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
