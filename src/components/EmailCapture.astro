---
import { SITE, withBase } from '../lib/site';

const action = SITE.newsletterFormAction;
const ready = Boolean(action);

interface Props {
  variant?: 'section' | 'widget';
  heading?: string;
}

const {
  variant = 'section',
  heading = 'Get tips in your inbox',
} = Astro.props;

const isWidget = variant === 'widget';
---

{
  isWidget ? (
    <div class="nl-widget" aria-labelledby="email-capture-heading">
      <h2 id="email-capture-heading" class="font-display text-xl font-extrabold text-black sm:text-2xl">
        {heading}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-charcoal">
        Beginner FX tips from <span class="font-bold text-black">{SITE.name}</span>. No spam. Stop any time. Not financial advice.
      </p>
      {ready ? (
        <form id="nl-form" class="nl-form mt-5" action={action} method="POST" novalidate>
          <input type="hidden" name={SITE.newsletterSourceEntry} value="techonni.com · Euro Desk FX" />
          <input
            type="hidden"
            name={SITE.newsletterConsentEntry}
            value="Yes — I agree to receive emails from Euro Desk FX by Techonni"
          />
          <input type="hidden" name={SITE.newsletterNameEntry} value="—" />
          <div class="nl-row">
            <label class="sr-only" for="nl-email">Your email</label>
            <input
              id="nl-email"
              class="nl-email"
              name={SITE.newsletterEmailEntry}
              type="email"
              required
              autocomplete="email"
              placeholder="Enter your email address"
            />
            <button id="nl-submit" class="nl-submit" type="submit">
              Send me tips
            </button>
          </div>
          <p class="mt-3 text-xs text-muted-soft">
            By sending, you ask for tips by email.
            <a class="font-bold text-black underline underline-offset-2" href={withBase('/privacy/')}>Privacy</a>.
          </p>
        </form>
      ) : (
        <div class="mt-5 border-2 border-black bg-sage p-4 text-sm text-charcoal shadow-[4px_4px_0_#000]">
          <p class="font-bold text-black">Email signup connects next.</p>
          <p class="mt-2">
            Until then, join the free channel:
            <a class="link-arrow ml-1" href={SITE.telegram} target="_blank" rel="noopener noreferrer">
              Telegram →
            </a>
          </p>
        </div>
      )}
    </div>
  ) : (
    <section class="mx-auto max-w-[1440px] px-4 py-14 sm:px-6 lg:px-10" aria-labelledby="email-capture-heading">
      <div class="max-w-2xl">
        <h2 id="email-capture-heading" class="headline-md text-black" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">
          {heading}
        </h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-charcoal">
          Leave your email and you can receive beginner FX tips from
          <span class="font-bold text-black">{SITE.name}</span>
          ({SITE.byline}). No spam. Stop any time. This is not financial advice.
        </p>

        {ready ? (
          <form id="nl-form" class="nl-form mt-6" action={action} method="POST" novalidate>
            <input type="hidden" name={SITE.newsletterSourceEntry} value="techonni.com · Euro Desk FX" />
            <input
              type="hidden"
              name={SITE.newsletterConsentEntry}
              value="Yes — I agree to receive emails from Euro Desk FX by Techonni"
            />
            <input type="hidden" name={SITE.newsletterNameEntry} value="—" />
            <div class="nl-row">
              <label class="sr-only" for="nl-email">Your email</label>
              <input
                id="nl-email"
                class="nl-email"
                name={SITE.newsletterEmailEntry}
                type="email"
                required
                autocomplete="email"
                placeholder="Enter your email address"
              />
              <button id="nl-submit" class="nl-submit" type="submit">
                Send me tips
              </button>
            </div>
            <p class="mt-3 text-xs text-muted-soft">
              By sending, you ask for tips by email.
              <a class="font-bold text-black underline underline-offset-2" href={withBase('/privacy/')}>Privacy</a>.
            </p>
          </form>
        ) : (
          <div class="mt-6 border-2 border-black bg-sage p-4 text-sm text-charcoal shadow-[4px_4px_0_#000]">
            <p class="font-bold text-black">Email signup connects next.</p>
            <p class="mt-2">
              Until then, join the free channel:
              <a class="link-arrow ml-1" href={SITE.telegram} target="_blank" rel="noopener noreferrer">
                Telegram →
              </a>
            </p>
          </div>
        )}
      </div>
    </section>
  )
}

{
  ready && (
    <script is:inline>
      (function () {
        function setupNewsletter() {
          var form = document.getElementById('nl-form');
          var email = document.getElementById('nl-email');
          var btn = document.getElementById('nl-submit');
          if (!form || !email || !btn) return;
          if (form.dataset.bound === '1') return;
          form.dataset.bound = '1';

          form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!email.checkValidity()) {
              email.reportValidity();
              return;
            }

            var body = new FormData(form);
            btn.classList.add('is-flash');
            btn.disabled = true;

            fetch(form.action, {
              method: 'POST',
              mode: 'no-cors',
              body: body,
            }).catch(function () {});

            email.value = '';

            window.setTimeout(function () {
              btn.classList.remove('is-flash');
              btn.disabled = false;
            }, 1000);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setupNewsletter);
        } else {
          setupNewsletter();
        }
        document.addEventListener('astro:page-load', setupNewsletter);
      })();
    </script>
  )
}

<style is:global>
  .nl-widget {
    background: #ffffff;
    border: 2px solid #000;
    border-radius: 0.75rem;
    padding: 1.75rem 1.5rem;
    box-shadow: 8px 8px 0 #000;
  }

  @media (min-width: 640px) {
    .nl-widget {
      padding: 2rem 1.75rem;
    }
  }

  .nl-form {
    width: 100%;
    max-width: 28rem;
  }

  .nl-widget .nl-form {
    max-width: none;
  }

  .nl-row {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nl-email,
  .nl-submit {
    box-sizing: border-box;
    height: 3.5rem;
    min-height: 3.5rem;
    max-height: 3.5rem;
    width: 100%;
    margin: 0;
    font-size: 16px;
    line-height: 1.25;
  }

  .nl-email {
    -webkit-appearance: none;
    appearance: none;
    background: #ffffff;
    color: #000;
    padding: 0 1.25rem;
    outline: none;
    border-radius: 0.75rem;
    border: 2px solid #000;
  }

  .nl-email::placeholder {
    color: #4a524e;
  }

  .nl-email:focus {
    box-shadow: 4px 4px 0 #000;
  }

  .nl-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #000;
    color: #fff;
    border: 2px solid #000;
    border-radius: 0.75rem;
    font-weight: 700;
    box-shadow: 4px 4px 0 #ffe17c;
    cursor: pointer;
    transition:
      transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      box-shadow 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .nl-submit:hover {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 #ffe17c;
  }

  .nl-submit.is-flash {
    background: #ffe17c !important;
    color: #000 !important;
    border-color: #000 !important;
  }

  @media (min-width: 1024px) {
    .nl-form {
      max-width: 36rem;
    }

    .nl-widget .nl-form {
      max-width: none;
    }

    .nl-row {
      flex-direction: row;
      align-items: stretch;
      flex-wrap: nowrap;
    }

    .nl-email {
      flex: 1 1 auto;
      min-width: 0;
      width: auto;
    }

    .nl-submit {
      flex: 0 0 auto;
      width: auto;
      min-width: 11rem;
      padding: 0 1.5rem;
      white-space: nowrap;
    }
  }
</style>
