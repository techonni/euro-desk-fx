---
import { SITE, withBase } from '../lib/site';

const nav = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/blog/'), label: 'Blog' },
  { href: withBase('/about/'), label: 'About' },
  { href: withBase('/disclaimer/'), label: 'Disclaimer' },
];
---

<header class="border-b border-border">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-5 sm:px-6">
    <a href={withBase('/')} class="group flex items-center gap-3 no-underline">
      <img
        src={withBase('logo.svg')}
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 border border-border bg-bg-elevated"
      />
      <span class="label-micro text-fg group-hover:text-cream">{SITE.name}</span>
    </a>
    <nav class="flex flex-wrap items-center justify-end gap-1 text-sm sm:gap-3" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          class="label-micro px-2 py-1.5 text-muted transition hover:text-fg"
        >
          {item.label}
        </a>
      ))}
      <a
        href={SITE.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="badge-rect ml-1"
      >
        Telegram
      </a>
    </nav>
  </div>
</header>
