---
import { SITE, withBase } from '../lib/site';

const nav = [
  { href: withBase('/'), label: 'Início' },
  { href: withBase('/blog/'), label: 'Blog' },
  { href: withBase('/about/'), label: 'Sobre' },
  { href: withBase('/disclaimer/'), label: 'Disclaimer' },
];
---

<header class="border-b border-navy/10 bg-navy text-cream">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={withBase('/')} class="flex items-center gap-3 no-underline">
      <img src={withBase('logo.svg')} alt="" width="40" height="40" class="h-10 w-10 rounded-xl" />
      <span class="flex flex-col leading-tight">
        <span class="text-sm font-semibold tracking-wide text-cream sm:text-base">{SITE.name}</span>
        <span class="hidden text-xs text-mint sm:inline">Faceless FX · EURUSD & GBPUSD</span>
      </span>
    </a>
    <nav class="flex flex-wrap items-center justify-end gap-1 text-sm sm:gap-2" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-2.5 py-1.5 text-cream/85 transition hover:bg-white/10 hover:text-cream"
        >
          {item.label}
        </a>
      ))}
      <a
        href={SITE.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 rounded-full bg-coral px-3 py-1.5 font-medium text-navy transition hover:bg-coral-soft"
      >
        Telegram
      </a>
    </nav>
  </div>
</header>
