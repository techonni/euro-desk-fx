---
import { SITE, withBase } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="content-col footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="footer-name">{SITE.name}</p>
        <p class="footer-byline">{SITE.byline}</p>
        <p class="footer-copy">
          Lifetime VIP ideas on {SITE.pairs.join(' and ')}. Free beginner guides. Soft risk note on every page.
        </p>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <p class="footer-label">Explore</p>
          <a class="footer-link" href={withBase('/blog/')}>Blog →</a>
          <a class="footer-link" href={withBase('/vip/')}>Lifetime VIP →</a>
          <a class="footer-link" href={withBase('/about/')}>About →</a>
        </div>
        <div class="footer-col">
          <p class="footer-label">Legal</p>
          <a class="footer-link" href={withBase('/privacy/')}>Privacy →</a>
          <a class="footer-link" href={withBase('/disclaimer/')}>Disclaimer →</a>
        </div>
        <div class="footer-col">
          <p class="footer-label">Follow</p>
          <a class="footer-link" href={SITE.x} target="_blank" rel="noopener noreferrer">X {SITE.xHandle} →</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-legal">
        © {year} {SITE.byline}. This is not financial advice. Trading involves risk of loss. Educational content only.
      </p>
    </div>
  </div>
</footer>
