---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NfaBanner from '../../components/NfaBanner.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCollection, render } from 'astro:content';
import { SITE, withBase, absoluteUrl } from '../../lib/site';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const shareUrl = absoluteUrl(`/blog/${post.id}/`);
const shareTitle = post.data.title;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  ogType="article"
>
  <article class="content-col py-14 sm:py-20">
    <p class="label-micro">
      <a href={withBase('/blog/')} class="font-medium text-fg no-underline hover:opacity-55">Blog</a>
      <span class="mx-2 text-muted-soft">/</span>
      <span>Guide</span>
    </p>
    <h1 class="headline-md mt-3">{post.data.title}</h1>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <time class="label-micro" datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('en-GB', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
      {
        post.data.tags.map((tag) => (
          <span class="rounded-full bg-input px-2.5 py-0.5 text-xs font-medium text-muted">{tag}</span>
        ))
      }
    </div>
    <div class="mt-6">
      <ShareButtons url={shareUrl} title={shareTitle} />
    </div>
    <div class="mt-8">
      <NfaBanner />
    </div>
    <div class="prose-blog mt-10">
      <Content />
    </div>
    <div class="mt-12 rounded-xl bg-bg-muted p-6 sm:p-8">
      <p class="label-micro">Lifetime VIP</p>
      <h2 class="mt-2 text-xl font-semibold tracking-tight text-fg">Private ideas after checkout</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        Guides stay free. Session ideas on EURUSD and GBPUSD are Lifetime VIP for {SITE.vipPrice}. The invite is only shown after you pay.
      </p>
      <a href={SITE.checkoutUrl} class="btn-primary mt-5">Get Lifetime VIP {SITE.vipPrice} →</a>
    </div>
    <div class="mt-8">
      <ShareButtons url={shareUrl} title={shareTitle} />
    </div>
    <div class="mt-8 border-t border-border pt-6">
      <NfaBanner compact />
      <p class="mt-4">
        <a href={withBase('/blog/')} class="link-arrow">← All posts</a>
      </p>
    </div>
  </article>
</BaseLayout>
