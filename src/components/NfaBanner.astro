---
interface Props {
  compact?: boolean;
  onDark?: boolean;
}
const { compact = false, onDark = false } = Astro.props;
---

<aside
  class:list={[
    'nfa-banner',
    compact ? 'nfa-compact' : 'nfa-full',
    onDark ? 'nfa-on-dark' : '',
  ]}
  role="note"
  aria-label="Risk note"
>
  <p>
    <span class="nfa-label">NFA</span>
    <span class="nfa-dot">·</span>
    {
      compact
        ? 'Educational content only. This is not financial advice. Trading involves risk of loss.'
        : 'Everything on Euro Desk FX is for learning and discussion. This is not financial advice. Trading can lead to loss of capital. Only use money you can afford to lose.'
    }
  </p>
</aside>

<style>
  .nfa-banner {
    border: 1px solid #e8e8e8;
    background: #f7f7f7;
    color: #666;
    border-radius: 0.75rem;
  }

  .nfa-compact {
    padding: 0.55rem 0.85rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .nfa-full {
    padding: 0.85rem 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .nfa-on-dark {
    background: #f3f3f3;
    color: #666;
  }

  .nfa-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111;
  }

  .nfa-dot {
    margin: 0 0.45rem;
    opacity: 0.45;
  }
</style>
