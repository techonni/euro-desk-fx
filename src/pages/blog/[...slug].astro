---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NfaBanner from '../../components/NfaBanner.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCollection, render } from 'astro:content';
import { SITE, withBase, absoluteUrl } from '../../lib/site';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const shareUrl = absoluteUrl(`/blog/${post.id}/`);
const shareTitle = post.data.title;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  ogType="article"
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="label-micro">
      <a href={withBase('/blog/')} class="hover:text-fg">Blog</a>
      <span class="mx-2 text-border">/</span>
      <span>Guide</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-fg sm:text-4xl">{post.data.title}</h1>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <time class="label-micro" datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('en-GB', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
      {
        post.data.tags.map((tag) => (
          <span class="label-micro border border-border px-2 py-0.5 text-muted-soft">{tag}</span>
        ))
      }
    </div>
    <div class="mt-6">
      <ShareButtons url={shareUrl} title={shareTitle} />
    </div>
    <div class="mt-8">
      <NfaBanner />
    </div>
    <div class="prose-blog mt-10">
      <Content />
    </div>
    <div class="mt-12 border border-border bg-bg-elevated p-6">
      <p class="label-micro">Telegram</p>
      <h2 class="mt-2 text-xl font-semibold text-fg">Keep learning on the free channel</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        Join Euro Desk FX on Telegram for EURUSD and GBPUSD ideas in plain English. Soft risk notes included.
      </p>
      <a
        href={SITE.telegram}
        target="_blank"
        rel="noopener noreferrer"
        class="badge-rect-solid mt-5"
      >
        Open Telegram
      </a>
    </div>
    <div class="mt-8">
      <ShareButtons url={shareUrl} title={shareTitle} />
    </div>
    <div class="mt-8 border-t border-border pt-6">
      <NfaBanner compact />
      <p class="mt-4">
        <a href={withBase('/blog/')} class="link-arrow">← All posts</a>
      </p>
    </div>
  </article>
</BaseLayout>
