---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NfaBanner from '../../components/NfaBanner.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Artigos educativos em português sobre EURUSD, GBPUSD, risco e disciplina. Sempre NFA — Euro Desk FX."
  canonicalPath="/blog/"
>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-bold text-navy sm:text-4xl">Blog educativo</h1>
    <p class="mt-3 text-navy/70">
      Conteúdo em português sobre pares, risco e processo. Sem hype, sem VIP.
    </p>
    <div class="mt-6">
      <NfaBanner compact />
    </div>

    <ul class="mt-10 space-y-4">
      {
        posts.map((post) => (
          <li>
            <a
              href={withBase(`/blog/${post.id}/`)}
              class="block rounded-2xl border border-navy/10 bg-white p-5 shadow-sm transition hover:border-coral hover:shadow-md"
            >
              <div class="flex flex-wrap items-center gap-2 text-xs text-navy/50">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('pt-PT', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <span aria-hidden="true">·</span>
                <span class="uppercase tracking-wide">PT</span>
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-full bg-mint/25 px-2 py-0.5 text-navy/70">{tag}</span>
                ))}
              </div>
              <h2 class="mt-2 text-xl font-semibold text-navy">{post.data.title}</h2>
              <p class="mt-2 text-sm text-navy/65">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
