---
import { SITE, withBase } from '../lib/site';

const action = SITE.newsletterFormAction;
const ready = Boolean(action);

interface Props {
  variant?: 'section' | 'widget';
  heading?: string;
}

const {
  variant = 'section',
  heading = 'Get tips in your inbox',
} = Astro.props;

const isWidget = variant === 'widget';
---

{
  isWidget ? (
    <div class="nl-widget" aria-labelledby="email-capture-heading">
      <h2 id="email-capture-heading" class="nl-title">
        {heading}
      </h2>
      <p class="nl-copy">
        Beginner FX tips from <span class="font-semibold text-fg">{SITE.name}</span>. No spam. Stop any time. Not financial advice.
      </p>
      {ready ? (
        <form id="nl-form" class="nl-form mt-4" action={action} method="POST" novalidate>
          <input type="hidden" name={SITE.newsletterSourceEntry} value="techonni.com · Euro Desk FX" />
          <input
            type="hidden"
            name={SITE.newsletterConsentEntry}
            value="Yes — I agree to receive emails from Euro Desk FX by Techonni"
          />
          <input type="hidden" name={SITE.newsletterNameEntry} value="—" />
          <div class="nl-row">
            <label class="sr-only" for="nl-email">Your email</label>
            <input
              id="nl-email"
              class="nl-email"
              name={SITE.newsletterEmailEntry}
              type="email"
              required
              autocomplete="email"
              placeholder="Enter your email address"
            />
            <button id="nl-submit" class="nl-submit" type="submit">
              Send me tips
            </button>
          </div>
          <p class="nl-note">
            By sending, you ask for tips by email.
            <a href={withBase('/privacy/')}>Privacy</a>.
          </p>
        </form>
      ) : (
        <div class="nl-fallback">
          <p class="font-medium text-fg">Email signup connects next.</p>
          <p class="mt-2">
            Until then, join the free channel:
            <a class="link-arrow ml-1" href={SITE.telegram} target="_blank" rel="noopener noreferrer">
              Telegram →
            </a>
          </p>
        </div>
      )}
    </div>
  ) : (
    <section class="content-col py-14" aria-labelledby="email-capture-heading">
      <div class="max-w-xl">
        <h2 id="email-capture-heading" class="headline-md">
          {heading}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-muted">
          Leave your email and you can receive beginner FX tips from
          <span class="font-semibold text-fg">{SITE.name}</span>
          ({SITE.byline}). No spam. Stop any time. This is not financial advice.
        </p>

        {ready ? (
          <form id="nl-form" class="nl-form mt-6" action={action} method="POST" novalidate>
            <input type="hidden" name={SITE.newsletterSourceEntry} value="techonni.com · Euro Desk FX" />
            <input
              type="hidden"
              name={SITE.newsletterConsentEntry}
              value="Yes — I agree to receive emails from Euro Desk FX by Techonni"
            />
            <input type="hidden" name={SITE.newsletterNameEntry} value="—" />
            <div class="nl-row">
              <label class="sr-only" for="nl-email">Your email</label>
              <input
                id="nl-email"
                class="nl-email"
                name={SITE.newsletterEmailEntry}
                type="email"
                required
                autocomplete="email"
                placeholder="Enter your email address"
              />
              <button id="nl-submit" class="nl-submit" type="submit">
                Send me tips
              </button>
            </div>
            <p class="nl-note">
              By sending, you ask for tips by email.
              <a href={withBase('/privacy/')}>Privacy</a>.
            </p>
          </form>
        ) : (
          <div class="nl-fallback mt-6">
            <p class="font-medium text-fg">Email signup connects next.</p>
            <p class="mt-2">
              Until then, join the free channel:
              <a class="link-arrow ml-1" href={SITE.telegram} target="_blank" rel="noopener noreferrer">
                Telegram →
              </a>
            </p>
          </div>
        )}
      </div>
    </section>
  )
}

{
  ready && (
    <script is:inline>
      (function () {
        function setupNewsletter() {
          var form = document.getElementById('nl-form');
          var email = document.getElementById('nl-email');
          var btn = document.getElementById('nl-submit');
          if (!form || !email || !btn) return;
          if (form.dataset.bound === '1') return;
          form.dataset.bound = '1';

          form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!email.checkValidity()) {
              email.reportValidity();
              return;
            }

            var body = new FormData(form);
            btn.classList.add('is-flash');
            btn.disabled = true;

            fetch(form.action, {
              method: 'POST',
              mode: 'no-cors',
              body: body,
            }).catch(function () {});

            email.value = '';

            window.setTimeout(function () {
              btn.classList.remove('is-flash');
              btn.disabled = false;
            }, 1000);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setupNewsletter);
        } else {
          setupNewsletter();
        }
        document.addEventListener('astro:page-load', setupNewsletter);
      })();
    </script>
  )
}

<style is:global>
  .nl-widget {
    background: #f7f7f7;
    border-radius: 0.75rem;
    padding: 1.5rem 1.25rem;
  }

  @media (min-width: 640px) {
    .nl-widget {
      padding: 1.75rem 1.5rem;
    }
  }

  .nl-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: #111;
    letter-spacing: -0.01em;
  }

  .nl-copy {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #666;
  }

  .nl-form {
    width: 100%;
    max-width: 28rem;
  }

  .nl-widget .nl-form {
    max-width: none;
  }

  .nl-row {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.5rem;
  }

  .nl-email,
  .nl-submit {
    box-sizing: border-box;
    height: 2.75rem;
    min-height: 2.75rem;
    max-height: 2.75rem;
    width: 100%;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.25;
    border-radius: 0.5rem;
    border: none;
  }

  .nl-email {
    -webkit-appearance: none;
    appearance: none;
    background: #fff;
    color: #111;
    padding: 0 1rem;
    outline: none;
    border: 1px solid #e8e8e8;
  }

  .nl-email::placeholder {
    color: #888;
  }

  .nl-email:focus {
    box-shadow: 0 0 0 2px #111;
    border-color: transparent;
  }

  .nl-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #111;
    color: #fff;
    font-weight: 560;
    cursor: pointer;
    padding: 0 1.25rem;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }

  .nl-submit:hover:not(:disabled) {
    opacity: 0.85;
  }

  .nl-submit:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .nl-submit.is-flash {
    background: #333 !important;
  }

  .nl-note {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: #888;
    line-height: 1.5;
  }

  .nl-note a {
    color: #111;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .nl-fallback {
    margin-top: 1rem;
    padding: 1rem 1.1rem;
    background: #fff;
    border: 1px solid #e8e8e8;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    color: #666;
  }

  @media (min-width: 1024px) {
    .nl-form {
      max-width: 36rem;
    }

    .nl-widget .nl-form {
      max-width: none;
    }

    .nl-row {
      flex-direction: row;
      align-items: stretch;
      flex-wrap: nowrap;
    }

    .nl-email {
      flex: 1 1 auto;
      min-width: 0;
      width: auto;
    }

    .nl-submit {
      flex: 0 0 auto;
      width: auto;
      min-width: 10rem;
      padding: 0 1.5rem;
      white-space: nowrap;
    }
  }
</style>
