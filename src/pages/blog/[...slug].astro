---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NfaBanner from '../../components/NfaBanner.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/site';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  ogType="article"
>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <p class="text-sm text-navy/55">
      <a href={withBase('/blog/')} class="underline decoration-mint underline-offset-2">Blog</a>
      <span aria-hidden="true"> / </span>
      <span>PT</span>
    </p>
    <h1 class="mt-3 text-3xl font-bold text-navy sm:text-4xl">{post.data.title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-navy/55">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('pt-PT', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
      {
        post.data.tags.map((tag) => (
          <span class="rounded-full bg-coral/20 px-2 py-0.5 text-xs text-navy">{tag}</span>
        ))
      }
    </div>
    <div class="mt-6">
      <NfaBanner />
    </div>
    <div class="prose-blog mt-8">
      <Content />
    </div>
    <div class="mt-10 border-t border-navy/10 pt-6">
      <NfaBanner compact />
      <p class="mt-4">
        <a href={withBase('/blog/')} class="text-sm font-medium text-navy-light underline decoration-mint"
          >← Todos os artigos</a
        >
      </p>
    </div>
  </article>
</BaseLayout>
