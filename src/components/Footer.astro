---
import { SITE, withBase } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer mt-0">
  <div class="mx-auto max-w-[1440px] px-4 py-14 sm:px-6 lg:px-10">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-sm">
        <p class="text-lg font-semibold text-fg">{SITE.name}</p>
        <p class="mt-2 text-sm text-muted-soft">{SITE.byline}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Free FX education and market ideas. Focus on {SITE.pairs.join(' and ')}. Soft risk note on every page.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-x-10 gap-y-3 text-sm sm:grid-cols-3">
        <div class="flex flex-col gap-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-soft">Explore</p>
          <a class="link-arrow" href={withBase('/blog/')}>Blog</a>
          <a class="link-arrow" href={withBase('/about/')}>About</a>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-soft">Legal</p>
          <a class="link-arrow" href={withBase('/privacy/')}>Privacy</a>
          <a class="link-arrow" href={withBase('/disclaimer/')}>Disclaimer</a>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-soft">Follow</p>
          <a class="link-arrow" href={SITE.telegram} target="_blank" rel="noopener noreferrer">Telegram</a>
          <a class="link-arrow" href={SITE.x} target="_blank" rel="noopener noreferrer">X {SITE.xHandle}</a>
        </div>
      </div>
    </div>
    <div class="mt-12 border-t border-border-soft pt-6">
      <p class="font-legal text-[13px] font-normal leading-relaxed text-muted-soft">
        © {year} {SITE.byline}. This is not financial advice. Trading involves risk of loss. Educational content only.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: rgba(22, 51, 0, 0.06);
    border-top: 1px solid rgb(16 16 8 / 0.12);
  }
</style>
