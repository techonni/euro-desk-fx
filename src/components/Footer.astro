---
import { SITE, withBase } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="content-col footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="footer-name">{SITE.name}</p>
        <p class="footer-byline">{SITE.byline}</p>
        <p class="footer-copy">
          Lifetime VIP ideas on {SITE.pairs.join(' and ')}. Free beginner guides. Soft risk note on every page.
        </p>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <p class="footer-label">Explore</p>
          <a class="footer-link" href={withBase('/blog/')}>Blog →</a>
          <a class="footer-link" href={withBase('/vip/')}>Lifetime VIP →</a>
          <a class="footer-link" href={withBase('/about/')}>About →</a>
        </div>
        <div class="footer-col">
          <p class="footer-label">Legal</p>
          <a class="footer-link" href={withBase('/privacy/')}>Privacy →</a>
          <a class="footer-link" href={withBase('/disclaimer/')}>Disclaimer →</a>
        </div>
        <div class="footer-col">
          <p class="footer-label">Follow</p>
          <a class="footer-link" href={SITE.x} target="_blank" rel="noopener noreferrer">X {SITE.xHandle} →</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-legal">
        © {year} {SITE.byline}. This is not financial advice. Trading involves risk of loss. Educational content only.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer { margin-top: 2rem; border-top: 1px solid #f0f0f0; background: #fff; padding: 3rem 0 3.5rem; }
  .footer-inner { display: flex; flex-direction: column; gap: 2rem; }
  .footer-top { display: flex; flex-direction: column; gap: 2rem; }
  @media (min-width: 768px) { .footer-top { flex-direction: row; justify-content: space-between; gap: 2.5rem; } }
  .footer-brand { max-width: 18rem; }
  .footer-name { margin: 0; font-size: 1rem; font-weight: 600; color: #111; }
  .footer-byline { margin: 0.35rem 0 0; font-size: 0.8125rem; color: #888; }
  .footer-copy { margin: 0.75rem 0 0; font-size: 0.875rem; line-height: 1.6; color: #666; }
  .footer-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2rem; }
  @media (min-width: 640px) { .footer-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .footer-col { display: flex; flex-direction: column; gap: 0.55rem; }
  .footer-label { margin: 0 0 0.15rem; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: #888; }
  .footer-link { color: #111; font-size: 0.875rem; font-weight: 500; text-decoration: none; }
  .footer-link:hover { opacity: 0.55; }
  .footer-bottom { border-top: 1px solid #f0f0f0; padding-top: 1.25rem; }
  .footer-legal { margin: 0; font-size: 0.8125rem; line-height: 1.6; color: #888; }
</style>
