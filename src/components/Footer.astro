---
import { SITE, withBase } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer mt-0">
  <div class="mx-auto max-w-[1440px] px-4 py-14 sm:px-6 lg:px-10">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-xl font-extrabold text-white">{SITE.name}</p>
        <p class="mt-2 text-sm font-medium text-sage">{SITE.byline}</p>
        <p class="mt-3 text-sm leading-relaxed text-sage/90">
          Free FX education and market ideas. Focus on {SITE.pairs.join(' and ')}. Soft risk note on every page.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-x-10 gap-y-3 text-sm sm:grid-cols-3">
        <div class="flex flex-col gap-3">
          <p class="text-xs font-bold uppercase tracking-wide text-sage">Explore</p>
          <a class="footer-link" href={withBase('/blog/')}>Blog</a>
          <a class="footer-link" href={withBase('/about/')}>About</a>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-xs font-bold uppercase tracking-wide text-sage">Legal</p>
          <a class="footer-link" href={withBase('/privacy/')}>Privacy</a>
          <a class="footer-link" href={withBase('/disclaimer/')}>Disclaimer</a>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-xs font-bold uppercase tracking-wide text-sage">Follow</p>
          <a class="footer-link" href={SITE.telegram} target="_blank" rel="noopener noreferrer">Telegram</a>
          <a class="footer-link" href={SITE.x} target="_blank" rel="noopener noreferrer">X {SITE.xHandle}</a>
        </div>
      </div>
    </div>
    <div class="mt-12 border-t-2 border-white/20 pt-6">
      <p class="font-legal text-[13px] font-medium leading-relaxed text-sage/80">
        © {year} {SITE.byline}. This is not financial advice. Trading involves risk of loss. Educational content only.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #171e19;
    border-top: 2px solid #000;
    color: #fff;
  }

  .footer-link {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }

  .footer-link:hover {
    opacity: 0.75;
  }
</style>
