---
import BaseLayout from '../layouts/BaseLayout.astro';
import NfaBanner from '../components/NfaBanner.astro';
import { SITE, withBase } from '../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const cards = [
  {
    badge: 'Free',
    title: 'Telegram',
    body: 'Join the free channel for EURUSD and GBPUSD ideas, session notes, and simple risk reminders.',
    href: SITE.telegram,
    external: true,
    cta: 'Open Telegram →',
    accent: 'cyan',
  },
  {
    badge: 'Learn',
    title: 'Blog',
    body: 'Short beginner guides in plain English. Read at your pace. No hype, no VIP paywall.',
    href: withBase('/blog/'),
    external: false,
    cta: 'Read the blog →',
    accent: 'indigo',
  },
  {
    badge: 'Focus',
    title: 'Two pairs',
    body: 'EURUSD and GBPUSD only. Less noise. Clear sessions. Room to study structure and risk.',
    href: withBase('/about/'),
    external: false,
    cta: 'How it works →',
    accent: 'orange',
  },
];

const accentBar: Record<string, string> = {
  cyan: 'bg-cyan',
  indigo: 'bg-indigo',
  orange: 'bg-orange',
};
---

<BaseLayout title={SITE.name} description={SITE.description} canonicalPath="/">
  <!-- Hero: square mark LEFT + title/intro RIGHT -->
  <section class="mx-auto max-w-5xl px-4 pb-12 pt-14 sm:px-6 sm:pb-16 sm:pt-20">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:gap-12">
      <div class="shrink-0">
        <div class="flex h-36 w-36 items-center justify-center border border-border bg-white p-3 sm:h-40 sm:w-40">
          <img
            src={withBase('brand-logo.svg')}
            alt="Euro Desk FX brand mark"
            width="160"
            height="160"
            class="h-full w-full object-contain"
          />
        </div>
      </div>
      <div class="min-w-0 flex-1 pt-1">
        <p class="label-micro">FX desk</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-fg sm:text-5xl md:text-6xl">
          Euro Desk FX
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
          Free FX education and market ideas focused on <span class="text-fg">EURUSD</span> and
          <span class="text-fg">GBPUSD</span>. Simple English. Clear process. Soft risk notes — this is not financial advice.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={SITE.telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="badge-rect-solid"
          >
            Join free Telegram
          </a>
          <a href={withBase('/blog/')} class="link-arrow">
            Read beginner guides →
          </a>
        </div>
      </div>
    </div>

    <hr class="mt-14 border-border" />
  </section>

  <!-- Product-style 3-column cards -->
  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6" aria-labelledby="table-heading">
    <div class="mb-8 flex items-baseline justify-between gap-4">
      <h2 id="table-heading" class="label-micro">On the desk</h2>
      <p class="label-micro">{cards.length} paths</p>
    </div>
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        cards.map((card) => (
          <li>
            <a
              href={card.href}
              target={card.external ? '_blank' : undefined}
              rel={card.external ? 'noopener noreferrer' : undefined}
              class="group flex h-full flex-col border border-border bg-bg-elevated transition hover:border-[#333]"
            >
              <div class="relative aspect-[4/3] overflow-hidden border-b border-border bg-bg">
                <div class:list={['absolute inset-x-0 top-0 h-1', accentBar[card.accent]]} />
                <div class="absolute left-3 top-3">
                  <span class="badge-rect">{card.badge}</span>
                </div>
                <div class="flex h-full items-end p-5">
                  <p class="text-3xl font-bold tracking-tight text-fg">{card.title}</p>
                </div>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class="flex-1 text-sm leading-relaxed text-muted">{card.body}</p>
                <p class="link-arrow mt-4 group-hover:text-fg">{card.cta}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6" aria-labelledby="how-heading">
    <h2 id="how-heading" class="label-micro">How it works</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2">
      <li class="border-t border-border pt-4">
        <p class="label-micro text-cyan">01</p>
        <h3 class="mt-2 text-lg font-semibold text-fg">Open Telegram</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Join the free channel. No VIP pricing. Ideas and context for study — not orders to copy blindly.
        </p>
      </li>
      <li class="border-t border-border pt-4">
        <p class="label-micro text-electric">02</p>
        <h3 class="mt-2 text-lg font-semibold text-fg">Stay on two pairs</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          EURUSD and GBPUSD. High liquidity. Clear London and New York sessions. Easier to track.
        </p>
      </li>
      <li class="border-t border-border pt-4">
        <p class="label-micro text-indigo">03</p>
        <h3 class="mt-2 text-lg font-semibold text-fg">Read the context</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Each idea comes with structure and a risk note. Use it to learn process, not to chase wins.
        </p>
      </li>
      <li class="border-t border-border pt-4">
        <p class="label-micro text-orange">04</p>
        <h3 class="mt-2 text-lg font-semibold text-fg">Respect risk</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Size positions small. Accept losses. This is not financial advice — protect your capital first.
        </p>
      </li>
    </ol>
  </section>

  <!-- Latest blog -->
  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6" aria-labelledby="blog-heading">
    <div class="mb-8 flex items-baseline justify-between gap-4">
      <h2 id="blog-heading" class="label-micro">From the blog</h2>
      <a href={withBase('/blog/')} class="link-arrow">All posts →</a>
    </div>
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        posts.map((post) => (
          <li>
            <a
              href={withBase(`/blog/${post.id}/`)}
              class="group block h-full border border-border bg-bg-elevated p-5 transition hover:border-[#333]"
            >
              <time class="label-micro" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-GB', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-3 text-base font-semibold text-fg group-hover:text-cream">{post.data.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- CTA band -->
  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <div class="border border-border bg-bg-elevated px-6 py-10 sm:px-10">
      <p class="label-micro">Next step</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-fg sm:text-3xl">
        Start with the free Telegram
      </h2>
      <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted sm:text-base">
        Follow EURUSD and GBPUSD ideas in plain English. Read the blog for basics. Keep risk small.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href={SITE.telegram}
          target="_blank"
          rel="noopener noreferrer"
          class="badge-rect-solid"
        >
          Open Telegram
        </a>
        <a
          href={SITE.x}
          target="_blank"
          rel="noopener noreferrer"
          class="link-arrow"
        >
          Follow on X {SITE.xHandle} →
        </a>
      </div>
      <div class="mt-8 max-w-2xl">
        <NfaBanner compact />
      </div>
    </div>
  </section>
</BaseLayout>
